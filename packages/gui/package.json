{
  "name": "cat-gui",
  "version": "0.0.3",
  "description": "Cat — A Portable Live GitHub Backup",
  "author": "ThePsychof",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/app-entry.ts --bundle --outfile=resources/js/bundle.js --format=iife --target=es2020",
    "start": "npm run build && neu run",
    "package:win": "npm run build && neu build --release",
    "package:mac": "npm run build && neu build --release",
    "package:linux": "npm run build && neu build --release"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@cat/shared": "*",
    "@neutralinojs/lib": "^6.9.0",
    "isomorphic-git": "^1.32.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
